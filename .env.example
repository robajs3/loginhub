# === Baza danych Huba ===
POSTGRES_USER=hub
POSTGRES_PASSWORD=zmien_to_haslo
POSTGRES_DB=hub

# === Sekrety Huba ===
# Sekret do podpisywania sesji Flask (panel admina/logowanie samego Huba)
SECRET_KEY=wygeneruj_losowy_string_min_32_znaki

# Sekret do podpisywania tokenu SSO — TEN SAM string musi trafić do .env
# każdej z 8 appek jako SSO_SECRET. Wygeneruj raz, np.:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
SSO_SECRET=wygeneruj_losowy_string_min_32_znaki_inny_niz_powyzszy

# Nazwa ciasteczka SSO (musi być identyczna w Hubie i we wszystkich appkach)
SSO_COOKIE_NAME=sso_session

# Czas życia sesji SSO w dniach
SSO_SESSION_DAYS=30

# === Połączenia do baz innych appek (tylko do odczytu, do panelu linkowania kont) ===
# Format: postgresql://user:haslo@host:port/nazwa_bazy
#
# Apki systemd (host.docker.internal = ten sam serwer Dell, port 5432 Postgresa hosta):
KOLOSEUM_DB_URL=postgresql://koloseum:haslo@host.docker.internal:5432/koloseum
GAMEPLAN_DB_URL=postgresql://gameplan:haslo@host.docker.internal:5432/gameplan
# filevault ma bazę na INNYM hoście w LAN (nie host.docker.internal):
FILEVAULT_DB_URL=postgresql://filetransfer:haslo@192.168.1.150:5432/filetransfer

# Apki dockerowe — host to NAZWA KONTENERA bazy (musi być w sieci sso_net, patrz README):
ZFLIX_DB_URL=postgresql://zflix_user:haslo@zflix-db-1:5432/zflix
EASYCONV_DB_URL=postgresql://easyconv:haslo@easyconv-db-1:5432/easyconv
HOMELIBRARY_DB_URL=postgresql://homelibrary:haslo@home-library-db-1:5432/homelibrary
NOTEMASTER_DB_URL=postgresql://notemaster:haslo@notemaster_db:5432/notemaster
PLANOWIEC_DB_URL=postgresql://planowiec_user:haslo@planowiec-db-1:5432/planowiec
VMPORTAL_DB_URL=postgresql://vmportal_app:haslo@vmportal-postgres:5432/app_db
